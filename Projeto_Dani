.container {
  max-width: 500px;
  margin: 80px auto;
  padding: 30px;
  background-color: white;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 4px 12px #00000015;
}

h1 {
  margin-bottom: 20px;
}

p {
  line-height: 1.6;
}

.botao {
  display: block;
  width: 100%;
  margin: 12px 0;
  padding: 12px;
  border: none;
  border-radius: 6px;
  background-color: #2563eb;
  color: white;
  font: inherit;
  text-decoration: none;
  cursor: pointer;
}

.botao:hover {
  background-color: #1d4ed8;
}

.link-voltar {
  display: inline-block;
  margin-top: 15px;
  color: #2563eb;
}

#mensagem {
  margin-top: 15px;
}

[hidden] {
  display: none !important;
}
